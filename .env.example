SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?ssl=true

# Set this to the email address of an existing faculty account to grant it faculty-admin access.
# Only that account can create additional faculty accounts from the Manage faculty page.
FACULTY_ADMIN_EMAIL=
# Keep public faculty self-registration disabled.
ALLOW_FACULTY_REGISTRATION=false
# Set false only for local HTTP development. Keep true in production HTTPS.
COOKIE_SECURE=true
