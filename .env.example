# Copy this file to .env before running the application.
# Local development example. Never commit your real .env file.

SECRET_KEY=replace-with-a-long-random-secret

# Use the same Aiven MySQL database as production if you want the same faculty accounts/data.
# Copy the connection details from Aiven and URL-encode special characters in the password.
# Keep ?ssl=true at the end for Aiven TLS connections.
DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?ssl=true

# Email address of an existing faculty account that should have faculty-admin permissions.
FACULTY_ADMIN_EMAIL=

# Keep public faculty self-registration disabled.
ALLOW_FACULTY_REGISTRATION=false

# Local VS Code runs on HTTP, so set false here. Set true on the HTTPS production deployment.
COOKIE_SECURE=false

# Optional: set this only if you use the faculty password-recovery feature.
# FACULTY_PASSWORD_RESET_CODE=
