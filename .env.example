SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?ssl=true

# Set true only for local testing if you intentionally enable faculty self-registration.
ALLOW_FACULTY_REGISTRATION=false
# Set false only for local HTTP development. Keep true in production HTTPS.
COOKIE_SECURE=true
